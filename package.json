{
  "name": "godot-bridge",
  "version": "0.2.0",
  "description": "DSH (DeepSeek Harness) plugin: launch and drive a running Godot 4.x game through its in-game TCP interaction server — replaces the godot-mcp MCP server with native agent tools.",
  "type": "module",
  "main": "plugin/godot-bridge.mjs",
  "exports": {
    ".": "./plugin/godot-bridge.mjs",
    "./client": "./client/client.js"
  },
  "files": [
    "plugin/",
    "client/",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "CHANGELOG.zh-CN.md",
    "scripts/",
    "LICENSE",
    "install.md",
    "install.zh-CN.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "godot",
    "godot-engine",
    "godot-plugin",
    "mcp",
    "game-development",
    "ai-agent"
  ],
  "scripts": {
    "check": "node scripts/check-plugin-contract.mjs && node scripts/check-client.mjs",
    "check:client": "node scripts/check-client.mjs",
    "doctor": "node scripts/doctor.mjs",
    "install-plugin": "node scripts/install.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.6-0",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nana7mi0721/godot-bridge.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "godotBridge": {
    "compat": {
      "dsh": ">=0.2.0-rc.2",
      "dshTested": "0.2.0-rc.2",
      "godot": {
        "min": "4.0",
        "max": "4.7",
        "tested": "4.7.2"
      }
    },
    "forkOf": "Smalldy/godot-bridge",
    "fork": "Nana7mi0721/godot-bridge"
  }
}
